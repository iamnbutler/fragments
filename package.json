{
  "name": "fragments",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bongo dev",
    "build": "bongo build --fresh --minify",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:build": "npm run build && node tests/build-smoke.mjs",
    "check": "tsc -p tsconfig.lib.json && tsc -p worker/tsconfig.json",
    "media": "tsx scripts/media.ts",
    "figure-motion": "tsx scripts/figure-motion.ts"
  },
  "dependencies": {
    "@shikijs/rehype": "^3.22.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.22.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "agentation": "^3.1.2",
    "bongo": "npm:@bongo/bongo@^1.0.0",
    "gray-matter": "^4.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.21.0",
    "wrangler": "^4.146.0"
  },
  "engines": {
    "node": ">=24"
  }
}
