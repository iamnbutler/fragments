{
  // The site: static pages from public/, media from R2 at /m/ (see worker/).
  "name": "fragments",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "fragments-media", "remote": true }],
  "observability": { "enabled": true }
}
