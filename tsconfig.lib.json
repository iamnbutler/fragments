{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "bongo.config.ts",
    "src/**/*.ts",
    "assets/scripts/**/*.ts",
    "scripts/**/*.ts",
    "tests/*.test.ts"
  ]
}
