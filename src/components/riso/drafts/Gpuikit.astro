---
/**
 * gpuikit as a mail-order parts catalog, "Catalog No. 0.9": a cover, a
 * specimen sheet of all 44 element modules, and the rules page. Blue and
 * black for engineering, teal for rules and breakage, yellow for one stamp.
 */
import Reg from '../Reg.astro';
import Linked from '../Linked.astro';
import Plate from '../Plate.astro';
import InkFig from './InkFig.astro';
import Prose from './Prose.astro';
import Cont from './Cont.astro';
import { img } from '../../../lib/drafts';
import { media } from './util';
import type { Spread } from '../../../lib/zine';

interface Props { spread: Extract<Spread, { kind: 'draft' }>; }
const { spread } = Astro.props;
const { draft: d, part, blocks } = spread;
const end = !spread.jump && blocks.length > 0;
const home = media(img(d, 'showcase-home.png'), 0.2);
const sizes = media(img(d, 'showcase-control-sizes.png'), 0.18);
const q = d.pullquotes;
// The element modules declared in src/elements.rs at v0.9.0.
const PARTS = 'accordion alert aspect_ratio avatar badge breadcrumb button button_group calendar card checkbox collapsible combobox command context_menu dialog empty field form icon_button input kbd label list loading_indicator popover progress radio_group scroll_area select separator sidebar slider splitter switch table tabs text_field textarea toast toggle toggle_group tooltip typography'.split(' ');
const no = (n: number) => `GK-${String(n).padStart(3, '0')}`;
const CARGO = [
  'gpui = { package = "gpui-unofficial", version = "1.14" }',
  'gpui_platform = { package = "gpui-platform-gpui-unofficial", version = "1.14", features = ["font-kit"] }',
  'gpuikit = "0.9"',
];
---
{part === 0 && (
  <Fragment>
    <div class="gk-field" aria-hidden="true">
      {home && <Plate media={home} inks={['blue', 'black']} mode="mono" fit="cover" alt="" eager />}
    </div>
    <Reg as="h2" text={d.title} class="t-tower gk-title" />
    <div class="gk-names" role="group" aria-label="Three names: vitesse, then gpui-kit, then gpuikit">
      <span class="gk-name struck">vitesse<small>Oct 2023</small></span>
      <span class="gk-arrow" aria-hidden="true">→</span>
      <span class="gk-name struck">gpui-kit<small>May 2024</small></span>
      <span class="gk-arrow" aria-hidden="true">→</span>
      <span class="gk-name">gpuikit<small>Nov 2025</small></span>
    </div>
    <aside class="gk-issue">
      <p class="gk-catno"><span>Catalog No. 0.9</span><span>{d.kicker}</span></p>
      <p class="dr-dek"><Linked parts={d.dekParts} /></p>
      <p class="cap">{img(d, 'showcase-home.png')?.caption}</p>
      <p class="cap">Continued on page {spread.page + 2}</p>
    </aside>
  </Fragment>
)}
{part === 1 && (
  <Fragment>
    <div class="pg pg-l gk-spec">
      <p class="gk-sheet-head"><span>Specimen sheet</span><span>Elements, 44 parts</span></p>
      <ol class="gk-grid" aria-label="The 44 element modules">
        {PARTS.map((p, i) => <li><span class="gk-no">{no(i + 1)}</span><span class="gk-part">{p}</span></li>)}
      </ol>
      <Prose flow={d.key} blocks={blocks} cols={2} end={end} dropcap />
    </div>
    <div class="pg pg-r gk-plate">
      <InkFig image={img(d, 'fig-1-layers.svg')} ink="lt" ghost="dk" class="gk-fig1" />
      <figure class="gk-snip">
        <span class="tape tape-a" aria-hidden="true"></span>
        <pre><code>{`use gpuikit::elements::button::button;
use gpuikit::layout::h_stack;

h_stack()
    .child(button("cancel", "Cancel"))
    .child(button("delete", "Delete").destructive().on_click(|_, _, _| {
        // ...
    }))`}</code></pre>
        <figcaption class="cap">Part GK-007, button, in use.</figcaption>
      </figure>
      <Cont spread={spread} />
    </div>
  </Fragment>
)}
{part === 2 && (
  <Fragment>
    <div class="pg pg-l gk-rules">
      <InkFig image={img(d, 'fig-2-rungs.svg')} ink="black" ghost="lt" class="gk-fig2" />
      <p class="gk-q gk-q1">{q[2]}</p>
      <Prose flow={d.key} blocks={blocks} cols={2} end={end} />
      <Cont spread={spread} />
    </div>
    <div class="pg pg-r gk-broke">
      {sizes && (
        <figure class="gk-sizes">
          <span class="tape tape-a" aria-hidden="true"></span>
          <Plate media={sizes} inks={['teal', 'black']} fit="contain" />
          <svg class="gk-ring" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M4 78C4 72.5 19 71.5 19.6 77.4 20.2 83.4 5 84.4 3.8 79.2 3.2 76.2 8 74.2 12 74.6" /></svg>
          <figcaption class="cap">{img(d, 'showcase-control-sizes.png')?.caption}</figcaption>
        </figure>
      )}
      <p class="gk-q gk-q2">{q[3]}</p>
      <div class="gk-disc">
        <div class="gk-entry"><span class="gk-no">Skeleton</span><p>A repeating animation asked gpui for another frame forever: one loading placeholder pinned its window at the display’s refresh rate.</p><span class="gk-stamp">Discontinued</span></div>
        <div class="gk-entry"><span class="gk-no">Grain</span><p>One quad per 4px cell, about 60,000 quads for a 1200×800 overlay.</p><span class="gk-stamp">Discontinued</span></div>
      </div>
      <div class="gk-order" role="group" aria-label="Order form: the three Cargo.toml lines">
        <p class="gk-order-head"><span>Order form</span><span>Cut along the dotted line and paste into Cargo.toml</span></p>
        <pre><code>[dependencies]
{CARGO.join('\n')}</code></pre>
      </div>
    </div>
  </Fragment>
)}
