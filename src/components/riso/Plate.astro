---
/**
 * A photo printed as riso plates. `duo` stacks a light plate and a key plate
 * (multiplied, independently misregistered); `key` prints the key plate
 * alone; `mono` prints the whole tonal range in the key ink.
 */
import type { Ink, PlateMedia } from '../../lib/zine';

interface Props {
  media: PlateMedia;
  inks: [Ink, Ink];
  mode?: 'duo' | 'key' | 'mono';
  alt?: string;
  class?: string;
  fit?: 'cover' | 'contain';
  eager?: boolean;
  /** keep the original underneath, for a "show original" toggle */
  proof?: boolean;
  style?: string;
}

const { media, inks, mode = 'duo', alt, class: cls, fit = 'cover', eager, proof, style } = Astro.props;
const label = alt ?? media.alt ?? '';
const loading = eager ? 'eager' : 'lazy';
const [lt, dk] = inks;
const ratio = media.aspect ? `--ar:${media.aspect.toFixed(4)};` : '';
---
<figure class:list={['plate', `plate-${mode}`, `fit-${fit}`, proof && 'has-proof', cls]} style={ratio + (style ?? '')}>
  <div class="plate-stack">
    {mode === 'mono' ? (
      <img class="ink ink-dk" src={media.src} alt={label} loading={loading} decoding="async" style={`filter:url(#ht-lt-${dk})`} />
    ) : mode === 'key' ? (
      <img class="ink ink-dk" src={media.src} alt={label} loading={loading} decoding="async" style={`filter:url(#ht-dk-${dk})`} />
    ) : (
      <Fragment>
        <img class="ink ink-lt" src={media.src} alt={label} loading={loading} decoding="async" style={`filter:url(#ht-lt-${lt})`} />
        <img class="ink ink-dk" src={media.src} alt="" aria-hidden="true" loading={loading} decoding="async" style={`filter:url(#ht-dk-${dk})`} />
      </Fragment>
    )}
    {proof && <img class="proof" src={media.src} alt="" aria-hidden="true" loading="lazy" decoding="async" />}
  </div>
</figure>
