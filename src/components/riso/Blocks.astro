---
import type { Block } from '../../lib/zine';
interface Props { blocks: Block[]; }
const { blocks } = Astro.props;
---
{blocks.map((b) =>
  b.t === 'h' ? <p class="b-h">{b.text}</p>
  : b.t === 'li' ? <p class="b-li">{b.text}</p>
  : b.t === 'code' ? <pre class="b-code">{b.text}</pre>
  : b.t === 'quote' ? <p class="b-q">{b.text}</p>
  : <p>{b.text}</p>
)}
