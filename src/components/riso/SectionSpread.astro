---
/**
 * A department opener: the left page is a print, each section its own motif,
 * with the section's name knocked out of it in paper; the right page says what the section is
 * for and lists what's in it, with page numbers.
 */
import Sheet from './Sheet.astro';
import Print from './Print.astro';
import { SECTIONS, type Spread } from '../../lib/zine';
import type { PrintMotif, PrintPalette } from '../../lib/spectrum';

interface Props { spread: Extract<Spread, { kind: 'section' }>; }
const { spread } = Astro.props;
const sec = SECTIONS[spread.key];
const PRINTS: Record<string, [PrintMotif, PrintPalette]> = {
  features: ['stair', 'dawn'],
  plates: ['rings', 'loop'],
  dispatches: ['woven', 'spectrum'],
  library: ['steps', 'spectrum'],
};
const [motif, palette] = PRINTS[spread.key] ?? ['sweep', 'spectrum'];
const MAX = 22;
const len = sec.title.length;
const fs = Math.min(22, 60 / (len * 0.5));
const fsm = Math.min(40, 88 / (len * 0.5));
const shown = spread.entries.slice(0, MAX);
const more = spread.entries.length - shown.length;
const last = spread.entries[spread.entries.length - 1]?.page ?? spread.page;
---
<Sheet spread={spread} label={`Section ${sec.no}: ${sec.title}`} running={`Section ${sec.no}`}>
  <div class="pg pg-l sec-flood" aria-hidden="true">
    <Print motif={motif} palette={palette} seed={spread.seed} paper={spread.paper} class="sec-print" />
    <span class="sec-word" style={`--sec-fs:${fs.toFixed(2)}cqw;--sec-fs-m:${fsm.toFixed(2)}vw`}>{sec.title}</span>
  </div>
  <div class="pg pg-r sec-body">
    <h2 class="sec-head"><span class="sec-head-no">Section {sec.no}</span> <span class="sec-head-title">{sec.title}</span></h2>
    <p class="cap sec-kicker">Pages {spread.page}&ndash;{last + 1}</p>
    <p class="sec-dek">{sec.dek}</p>
    <ol class="sec-list" aria-label={`In ${sec.title}`}>
      {shown.map((e) => (
        <li>
          <a href={`#p-${e.page}`}>
            <span class="sl-page">{e.page}</span>
            <span class="sl-title">{e.title}</span>
            <span class="sl-kind">{e.kind}</span>
          </a>
        </li>
      ))}
    </ol>
    {more > 0 && <p class="cap sec-more">And {more} more, through page {last + 1}.</p>}
  </div>
</Sheet>
