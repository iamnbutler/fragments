---
/**
 * The rest of a long essay, jumped from its opener the way magazines do.
 * Outbound links become numbered notes in the outer margin.
 */
import Sheet from './Sheet.astro';
import Blocks from './Blocks.astro';
import { domain, readingMinutes, type Block, type Spread } from '../../lib/zine';

interface Props { spread: Extract<Spread, { kind: 'jump' }>; }
const { spread } = Astro.props;
const { item, blocks: bs, refs, from, jump, last } = spread;
const hasNotes = refs.length > 0;
// Fill the left page first: roughly half the text, split on a block boundary.
const total = bs.reduce((n, b) => n + (b.t === 'code' ? b.text.split('\n').length * 40 : b.text.length), 0);
let acc = 0;
let split = bs.findIndex((b) => (acc += b.t === 'code' ? b.text.split('\n').length * 40 : b.text.length) > total * (hasNotes ? 0.56 : 0.5));
if (split < 0) split = bs.length - 1;
const left: Block[] = bs.slice(0, split + 1);
const right: Block[] = bs.slice(split + 1);
const mins = readingMinutes(item.text);
---
<Sheet spread={spread} label={`${item.title}, continued`} layout={hasNotes ? 'notes' : 'plain'} running={`Essay, ${mins} min`}>
  <div class="pg pg-l jump-a">
    <p class="jump-from">
      <a href={`#p-${from}`}>Continued from page {from}</a>
      <span class="jump-slug">{item.title}</span>
    </p>
    <div class="prose-cols cols-2" data-flow={item.key}>
      <Blocks blocks={left} refs end={last && !right.length} />
    </div>
  </div>
  <div class="pg pg-r jump-b">
    <div class="prose-cols cols-2" data-flow={item.key}>
      <Blocks blocks={right} refs end={last} />
    </div>
    {jump
      ? <a class="cont" href={`#p-${jump}`}>Continued on page {jump}</a>
      : last
        ? <a class="cont cont-single" href={item.href}>Read on its own page</a>
        : <a class="cont" href={item.href}>The rest is on its own page</a>}
  </div>
  {hasNotes && (
    <aside class="margin-notes" aria-label="Notes">
      <p class="mn-head">Notes</p>
      <ol>
        {refs.map((r) => (
          <li value={r.n}>
            <a href={r.url} target="_blank" rel="noopener">{r.label}</a>
            <span class="mn-where">{domain(r.url)}</span>
          </li>
        ))}
      </ol>
    </aside>
  )}
</Sheet>
