---
import Sheet from './Sheet.astro';
import Plate from './Plate.astro';
import Reg from './Reg.astro';
import { inline, paragraphs, printDate, rng, type Spread, type Ink } from '../../lib/zine';

interface Props { spread: Extract<Spread, { kind: 'shot' }>; }
const { spread } = Astro.props;
const { layout, items } = spread;
const item = items[0];
const r = rng(spread.seed);
const inks = spread.inks;
const swapped: [Ink, Ink] = [inks[1] === 'black' ? 'blue' : inks[1], inks[0]];
const mirror = r.chance(0.5);
const desc = paragraphs(item.text, item.title).slice(0, 2).map(inline).join(' ');
const shortDesc = desc.length > 260 ? desc.slice(0, 250).replace(/\s+\S*$/, '') + '…' : desc;
const date = printDate(item.date);
const spacedSize = Math.min(6.5, Math.max(2.4, 64 / item.title.length));
const n = item.media.length;
const corner = r.pick(['tl', 'tr', 'bl', 'br'] as const);
const circled = Math.floor(r.next() * Math.min(n, 8));
const label = items.length > 1 ? `Plates: ${items.map((i) => i.title).join(' and ')}` : `Plate: ${item.title}`;
---
<Sheet spread={spread} label={label} layout={layout} running={layout === 'diptych' ? 'Two plates' : `Plate, ${n} frame${n > 1 ? 's' : ''}`}>
  {layout === 'bleed' && (
    <Fragment>
      <a class="bleed-plate" href={item.href} tabindex="-1" aria-hidden="true">
        <Plate media={item.media[0]} inks={inks} alt={item.media[0].alt || item.title} />
      </a>
      <div class:list={['label-slip', `at-${corner}`]}>
        <Reg as="h2" text={item.title} href={item.href} class="t-spaced" style={`--fs:${Math.min(spacedSize, 3.6).toFixed(2)}cqw`} />
        {shortDesc && <p class="slip-desc">{shortDesc}</p>}
        <p class="cap">{date}. {n > 1 ? `${n} frames, see all on page ${item.id}.` : `Plate ${item.id}.`}</p>
      </div>
    </Fragment>
  )}

  {layout === 'plate' && (
    <Fragment>
      <a class:list={['pg', mirror ? 'pg-r' : 'pg-l', 'plate-page']} href={item.href} tabindex="-1" aria-hidden="true">
        <Plate media={item.media[0]} inks={inks} alt={item.media[0].alt || item.title} />
      </a>
      <div class:list={['pg', mirror ? 'pg-l' : 'pg-r', 'plate-notes']}>
        {shortDesc && <p class="notes-desc">{shortDesc}</p>}
        {n > 1 && (
          <div class="strip">
            {item.media.slice(1, 4).map((m, i) => (
              <figure class="strip-frame">
                <Plate media={m} inks={swapped} alt={m.alt || `${item.title}, frame ${i + 2}`} />
                <figcaption>{i + 2}</figcaption>
              </figure>
            ))}
          </div>
        )}
        <div class="outform">
          <Reg as="h2" text={item.title} href={item.href} class="t-spaced" style={`--fs:${spacedSize.toFixed(2)}cqw`} />
          <p class="cap">{date}. Plate {item.id}{n > 1 ? `, ${n} frames` : ''}.</p>
        </div>
      </div>
    </Fragment>
  )}

  {layout === 'contact' && (
    <Fragment>
      <div class="contact-head">
        <Reg as="h2" text={item.title} href={item.href} class="t-tower" style="--fs:4.2cqw" />
        <p class="cap">Contact sheet, {n} frames. {date}.{shortDesc && ` ${shortDesc}`}</p>
      </div>
      <ol class="contact-grid" data-n={Math.min(n, 8)}>
        {item.media.slice(0, 8).map((m, i) => (
          <li class:list={['frame', i === circled && 'is-circled']}>
            <a href={item.href} tabindex={i === 0 ? undefined : -1}>
              <Plate media={m} inks={i % 2 ? swapped : inks} alt={m.alt || `${item.title}, frame ${i + 1}`} />
            </a>
            <span class="frame-no">{i + 1}A</span>
            {i === circled && (
              <svg class="grease" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                <path pathLength="1" d="M8 52 C 6 18, 60 4, 88 22 S 96 86, 52 94 S 2 80, 12 40 S 40 8, 70 12" />
              </svg>
            )}
          </li>
        ))}
      </ol>
    </Fragment>
  )}

  {layout === 'toner' && (
    <Fragment>
      <a class="pg pg-l toner-plate" href={item.href} tabindex="-1" aria-hidden="true">
        <Plate media={item.media[0]} inks={inks} mode="rev" alt={item.media[0].alt || item.title} />
      </a>
      <div class="pg pg-r toner-side">
        {n > 1 && (
          <div class="toner-second">
            <Plate media={item.media[1]} inks={inks} mode="rev" alt={item.media[1].alt || `${item.title}, frame 2`} />
          </div>
        )}
        <div class="slip slip-small" style={`--tilt:${((spread.seed % 20) / 10 - 1).toFixed(2)}deg`}>
          <h2 class="slip-title"><a href={item.href}>{item.title}</a></h2>
          {shortDesc && <p>{shortDesc}</p>}
          <p class="cap">{date}. Plate {item.id}{n > 1 ? `, ${n} frames` : ''}.</p>
        </div>
      </div>
    </Fragment>
  )}

  {layout === 'diptych' && (
    items.map((it, i) => (
      <figure class:list={['pg', i ? 'pg-r' : 'pg-l', 'dip']}>
        <a href={it.href} class="dip-plate" tabindex="-1" aria-hidden="true">
          <Plate media={it.media[0]} inks={i ? swapped : inks} fit="contain" alt={it.media[0].alt || it.title} />
        </a>
        <figcaption>
          <Reg as="h2" text={it.title} href={it.href} class="t-spaced" style={`--fs:${Math.min(3.2, 34 / it.title.length).toFixed(2)}cqw`} />
          <span class="cap">{printDate(it.date)}. Plate {it.id}.</span>
        </figcaption>
      </figure>
    ))
  )}
</Sheet>
