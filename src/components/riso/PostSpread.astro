---
import Sheet from './Sheet.astro';
import Reg from './Reg.astro';
import Blocks from './Blocks.astro';
import { blocks, takeBlocks, excerpt, paragraphs, pullQuote, printDate, readingMinutes, type Spread } from '../../lib/zine';

interface Props { spread: Extract<Spread, { kind: 'post' }>; }
const { spread } = Astro.props;
const { item, layout } = spread;
const paras = paragraphs(item.text, item.title);
const mins = readingMinutes(item.text);
const date = printDate(item.date);
const len = item.title.length;

// Title sizes in container-width units, fitted to the title's length.
const towerSize = Math.min(12, Math.max(4.4, 112 / Math.pow(len, 0.72)));
const bannerSize = Math.min(5.6, Math.max(2.3, 150 / len));
const tonerSize = Math.min(9, Math.max(3.6, 70 / Math.pow(len, 0.62)));

const bs = blocks(item.text, item.title);
const tower = takeBlocks(bs, 2600);
const bannerA = takeBlocks(bs, 1900);
const bannerB = takeBlocks(bs, 1300, bannerA.next);
const toner = excerpt(paras, 640);
const quote = pullQuote(paras, spread.seed);
const tilt = ((spread.seed % 30) / 10 - 1.5).toFixed(2);
const slipTop = 8 + (spread.seed % 18);
---
<Sheet spread={spread} label={`Essay: ${item.title}`} layout={layout} running={`Essay, ${mins} min`}>
  {layout === 'tower' && (
    <Fragment>
      <div class="pg pg-l tower-title">
        <Reg as="h2" text={item.title} href={item.href} class="t-tower" style={`--fs:${towerSize.toFixed(2)}cqw`} />
        {quote && <blockquote class="pull pull-tower"><p>{quote}</p></blockquote>}
        <p class="cap">Essay no. {item.id}, {date}. About {mins} minute{mins > 1 ? 's' : ''} to read.</p>
      </div>
      <div class="pg pg-r tower-body">
        <div class="prose-cols cols-2 dropcap">
          <Blocks blocks={tower.blocks} />
        </div>
        <a class="cont" href={item.href}>Continued on page {item.id}</a>
      </div>
    </Fragment>
  )}

  {layout === 'banner' && (
    <Fragment>
      <header class="banner-head">
        <Reg as="h2" text={item.title} href={item.href} class="t-spaced" style={`--fs:${bannerSize.toFixed(2)}cqw`} />
        <p class="cap">{date}. Essay no. {item.id}, {mins} min.</p>
      </header>
      <div class="pg pg-l banner-a prose-cols cols-2 dropcap">
        <Blocks blocks={bannerA.blocks} />
      </div>
      <div class="pg pg-r banner-b">
        {quote && <blockquote class="pull"><p>{quote}</p></blockquote>}
        <div class="prose-cols cols-2">
          <Blocks blocks={bannerB.blocks} />
        </div>
        <a class="cont" href={item.href}>Continued on page {item.id}</a>
      </div>
    </Fragment>
  )}

  {layout === 'toner' && (
    <Fragment>
      <div class="pg pg-l toner-title">
        <span class="toner-no" aria-hidden="true">{item.id}</span>
        <h2 class="t-reverse" style={`--fs:${tonerSize.toFixed(2)}cqw`}><a href={item.href}>{item.title}</a></h2>
        <p class="cap">{date}, {mins} min read</p>
      </div>
      <div class="pg pg-r toner-slip-wrap">
        <div class="slip" style={`--tilt:${tilt}deg;--top:${slipTop}%`}>
          <span class="tape" aria-hidden="true"></span>
          <div class="slip-body">
            {toner.paras.map((p) => <p>{p}</p>)}
          </div>
          <a class="cont" href={item.href}>Continued on page {item.id}</a>
        </div>
      </div>
    </Fragment>
  )}
</Sheet>
