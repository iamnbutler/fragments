---
/**
 * The cover of _fragments: a ring print on toner for the left page; the name,
 * the issue and a stepped swatch print for the right. The prints are the art,
 * so the type stays plain black on paper.
 */
import Sheet from './Sheet.astro';
import Print from './Print.astro';
import type { Spread } from '../../lib/zine';

interface Props { spread: Spread; issue: number; printed: string; }
const { spread, issue, printed } = Astro.props;
---
<Sheet spread={spread} label="Cover" folio={false}>
  <div class="pg pg-l cover-art" aria-hidden="true">
    <Print motif="rings" palette="loop" paper="toner" seed={spread.seed} class="cover-rings" />
  </div>
  <div class="pg pg-r cover-face">
    <p class="cover-issue"><span>Issue {issue}</span> <span>{printed}</span></p>
    <h1 class="masthead">_fragments</h1>
    <p class="cover-dek">Work, writing and clippings from Nate Butler, designer at Zed, with the posts from other people he couldn't stop thinking about.</p>
    <a class="cover-turn" href="#p-2">Turn the page</a>
    <Print motif="steps" palette="spectrum" paper="newsprint" seed={spread.seed + 7} class="cover-steps" />
  </div>
</Sheet>
