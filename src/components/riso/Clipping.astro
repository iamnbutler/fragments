---
import Plate from './Plate.astro';
import { domain, printDate, rng } from '../../lib/zine';
import type { ReshareItem } from '../../lib/stream';

interface Props { clip: ReshareItem; i: number; seed: number; wild?: boolean; }
const { clip: c, i, seed, wild } = Astro.props;
const r = rng(seed + i * 977);
const spin = wild ? 8 : 4.5;
const rot = r.range(-spin, spin).toFixed(2);
const stampRot = r.range(-14, 10).toFixed(1);
const stampAt = r.pick(['tr', 'tr', 'br', 'bl'] as const);
const tapes = r.pick(['corners', 'top', 'side'] as const);
const a = c.original.author;
const name = a.displayName || a.handle;
const media = c.original.media;
const link = c.original.link;
const textLen = c.original.text.length;
const arrows = [
  'M4 40 C 30 6, 70 4, 92 30 M92 30 l-14 -2 M92 30 l-2 -13',
  'M6 10 C 20 50, 60 58, 94 34 M94 34 l-13 -4 M94 34 l-6 12',
  'M90 8 C 60 6, 20 20, 8 50 M8 50 l3 -13 M8 50 l12 -6',
];
const arrow = arrows[(seed + i) % arrows.length];
---
<div class:list={['clip-slot', `slot-${i}`, c.comment && 'has-annot']}>
  <article
    class:list={['clip', textLen > 240 && 'clip-long', !c.original.text && 'clip-bare', `tapes-${tapes}`]}
    style={`--rot:${rot}deg;--stamp-rot:${stampRot}deg`}
    data-drag
    aria-label={`Post by ${name} (@${a.handle}), ${c.via === 'quote' ? 'quoted' : 'reposted'} by Nate`}
  >
    <span class="tape tape-a" aria-hidden="true"></span>
    <span class="tape tape-b" aria-hidden="true"></span>
    <div class="clip-paper">
      <header class="clip-head">
        <a class="clip-av" href={a.href} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
          {a.avatar ? (
            <img src={a.avatar} alt="" loading="lazy" decoding="async" style="filter:url(#ht-av-black)" />
          ) : (
            <span class="clip-av-blank">{name.slice(0, 1)}</span>
          )}
        </a>
        <p class="clip-who">
          <a class="clip-name" href={a.href} target="_blank" rel="noopener">{name}</a>
          <span class="clip-handle">@{a.handle}</span>
        </p>
        <time class="clip-date" datetime={c.original.date}>{printDate(c.original.date)}</time>
      </header>
      {c.original.text && <p class="clip-text">{c.original.text}</p>}
      {media.length > 0 && (
        <div class:list={['clip-media', media.length > 1 && 'multi']}>
          {media.slice(0, media.length > 2 ? 4 : 2).map((m) => (
            <Plate media={m} inks={['black', 'black']} mode="mono" alt={m.alt} href={c.original.href} />
          ))}
        </div>
      )}
      {link && (
        <a class="clip-link" href={link.uri} target="_blank" rel="noopener">
          <span class="clip-link-title">{link.title || domain(link.uri)}</span>
          <span class="clip-link-domain">{domain(link.uri)}</span>
        </a>
      )}
      <a class="clip-src" href={c.original.href} target="_blank" rel="noopener">Original post on Bluesky</a>
    </div>
    <div class:list={['stamp', `stamp-${stampAt}`]} aria-hidden="true">
      <span class="stamp-top">Clipped from</span>
      <span class="stamp-handle">@{a.handle}</span>
      <span class="stamp-date">{printDate(c.date)}</span>
    </div>
  </article>
  {c.comment ? (
    <aside class="annot" aria-label="Nate's note">
      <svg class="annot-arrow" viewBox="0 0 100 60" aria-hidden="true"><path d={arrow} /></svg>
      <p>{c.comment}</p>
      <span class="annot-sig">nate</span>
    </aside>
  ) : null}
</div>
