---
/**
 * Other people's posts, pasted in. Each one is a photocopy of the original
 * (their avatar, name, handle, words and pictures), taped down at an angle,
 * stamped with who it was clipped from, and annotated by Nate in another ink
 * when he quoted it. Clippings can be picked up and moved around the spread.
 *
 * Layouts: solo / pair / trio (clippings side by side), wall (short posts
 * pinned up in a scatter), blowup (one short post enlarged across the spread
 * with its author's portrait printed as a full plate).
 */
import Sheet from './Sheet.astro';
import Plate from './Plate.astro';
import Clipping from './Clipping.astro';
import { printDate, rng, type Spread } from '../../lib/zine';

interface Props { spread: Extract<Spread, { kind: 'clippings' }>; }
const { spread } = Astro.props;
const { items, layout } = spread;
const names = [...new Set(items.map((c) => c.original.author.displayName || c.original.author.handle))];
const handles = [...new Set(items.map((c) => '@' + c.original.author.handle))];
const solo = layout === 'solo' ? items[0] : null;
const soloName = solo ? solo.original.author.displayName || solo.original.author.handle : '';
const ghostSize = Math.min(16, Math.max(6, 110 / Math.max(soloName.length, 4)));

const big = layout === 'blowup' ? items[0] : null;
const bigA = big?.original.author;
const bigName = bigA ? bigA.displayName || bigA.handle : '';
const bigLen = big ? big.original.text.length : 0;
const bigSize = Math.min(5.4, Math.max(2.6, 46 / Math.pow(bigLen, 0.5)));
const bigNameSize = Math.min(9, Math.max(3.6, 60 / Math.pow(bigName.length, 0.75)));
const r = rng(spread.seed);
const stampRot = r.range(-16, 8).toFixed(1);
---
<Sheet spread={spread} label={`Clippings from ${names.join(', ')}`} layout={layout} running="Clippings">
  <p class="clip-edge" aria-hidden="true">Clipped from Bluesky: {handles.join('  ')}</p>

  {big && bigA ? (
    <Fragment>
      <div class="pg pg-l blow-portrait">
        <a href={bigA.href} target="_blank" rel="noopener" class="blow-av" tabindex="-1" aria-hidden="true">
          {bigA.avatar ? (
            <Plate media={{ src: bigA.avatar.replace('/avatar_thumbnail/', '/avatar/'), alt: '' }} inks={spread.inks} alt="" />
          ) : (
            <span class="blow-initial">{bigName.slice(0, 1)}</span>
          )}
        </a>
        <p class="blow-who">
          <a class="reg t-tower" href={bigA.href} target="_blank" rel="noopener" style={`--fs:${bigNameSize.toFixed(2)}cqw`}><span class="reg-in" data-text={bigName}>{bigName}</span></a>
          <span class="blow-handle">@{bigA.handle}, on Bluesky, {printDate(big.original.date)}</span>
        </p>
      </div>
      <div class="pg pg-r blow-words">
        <blockquote class="blow-text" style={`--fs:${bigSize.toFixed(2)}cqw`} cite={big.original.href}>
          <p>{big.original.text}</p>
        </blockquote>
        <p class="blow-src">
          <a href={big.original.href} target="_blank" rel="noopener">Original post by {bigName} on Bluesky</a>
        </p>
        <div class="stamp stamp-big" aria-hidden="true" style={`--stamp-rot:${stampRot}deg`}>
          <span class="stamp-top">Clipped from</span>
          <span class="stamp-handle">@{bigA.handle}</span>
          <span class="stamp-date">{printDate(big.date)}</span>
        </div>
        {big.comment && (
          <aside class="annot annot-big" aria-label="Nate's note">
            <p>{big.comment}</p>
            <span class="annot-sig">nate</span>
          </aside>
        )}
      </div>
    </Fragment>
  ) : (
    <Fragment>
      {solo && <p class="ghost-name" aria-hidden="true" style={`--fs:${ghostSize.toFixed(2)}cqw`}>{soloName}</p>}
      {items.map((c, i) => <Clipping clip={c} i={i} seed={spread.seed} wild={layout === 'wall'} />)}
    </Fragment>
  )}
</Sheet>
