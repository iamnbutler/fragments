---
import Sheet from './Sheet.astro';
import Reg from './Reg.astro';
import { SECTIONS, spreadTitle, type Spread } from '../../lib/zine';

interface Props { spread: Spread; spreads: Spread[]; issue: number; }
const { spread, spreads, issue } = Astro.props;
const KIND: Record<string, string> = {
  post: 'Essay',
  shot: 'Plate',
  list: 'Index',
  bulletin: 'Dispatch',
  clippings: 'Clippings',
  draft: 'Proof',
};
const entries = spreads.filter((s) => s.kind !== 'cover' && s.kind !== 'contents' && s.kind !== 'jump' && !(s.kind === 'draft' && s.part > 0));
---
<Sheet spread={spread} label="Contents" running={`Issue ${issue}`}>
  <div class="contents-head">
    <Reg as="h2" text="Contents" class="t-spaced" style="--fs:5.4cqw" />
    <p class="colophon">
      _fragments is printed in pink, red, blue and black on warm newsprint, with gradient prints
      pulled from the whole Printmaking Challenge spectrum, from whatever Nate published to his AT Protocol repository.
      Set in Archivo, Source Serif 4 and Gochi Hand.
      Use the arrow keys, or J and K, to turn the pages, and F to see every spread at once.
      Every ink, typeface and layout is in the <a href="/styleguide">specimen book</a>.
    </p>
  </div>
  <nav class="contents-list" aria-label="Contents">
    <ol>
      {entries.map((s) => s.kind === 'section' ? (
        <li class="ck-section">
          <a href={`#p-${s.page}`}>
            <span class="ct-page">{SECTIONS[s.key].no}</span>
            <span class="ct-sec">{SECTIONS[s.key].title}</span>
          </a>
        </li>
      ) : (
        <li class={`ck-${s.kind}`}>
          <a href={`#p-${s.page}`}>
            <span class="ct-page">{s.page}</span>
            <span class="ct-kind">{KIND[s.kind]}</span>
            <span class="ct-title">{spreadTitle(s)}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</Sheet>
