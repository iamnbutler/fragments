---
import Base from '../layouts/Base.astro';
import Cover from '../components/riso/Cover.astro';
import Bio from '../components/riso/Bio.astro';
import JumpSpread from '../components/riso/JumpSpread.astro';
import DraftSpread from '../components/riso/drafts/DraftSpread.astro';
import { loadDrafts } from '../lib/drafts';
import { impose } from '../lib/zine';
import { ISSUE } from '../lib/issue';

const spreads = impose(loadDrafts());
---
<Base description={`_fragments, issue ${ISSUE.number}, ${ISSUE.season}: work and writing from Nate Butler.`} bodyClass="issue">
  <main class="zine">
    {spreads.map((s) => {
      switch (s.kind) {
        case 'cover': return <Cover spread={s} />;
        case 'bio': return <Bio spread={s} />;
        case 'jump': return <JumpSpread spread={s} />;
        case 'draft': return <DraftSpread spread={s} />;
      }
    })}
    <footer class="colophon-end">
      <p>End of issue {ISSUE.number}. Back to the <a href="#p-0">cover</a>.</p>
    </footer>
  </main>
  <script>
    import { pressRun } from '../scripts/press';
    pressRun();
  </script>
</Base>
