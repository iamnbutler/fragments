---
import Base from '../layouts/Base.astro';
import Cover from '../components/riso/Cover.astro';
import Contents from '../components/riso/Contents.astro';
import PostSpread from '../components/riso/PostSpread.astro';
import ShotSpread from '../components/riso/ShotSpread.astro';
import ListSpread from '../components/riso/ListSpread.astro';
import BulletinSpread from '../components/riso/BulletinSpread.astro';
import ClippingsSpread from '../components/riso/ClippingsSpread.astro';
import SectionSpread from '../components/riso/SectionSpread.astro';
import JumpSpread from '../components/riso/JumpSpread.astro';
import { loadStream } from '../lib/stream';
import { impose } from '../lib/zine';
import { measureAll } from '../lib/tone';

const stream = await loadStream();
const spreads = impose(stream);
// Check every plate's tone so dark images can be separated as negatives.
await measureAll(stream.flatMap((i) => {
  if (i.kind === 'reshare') return [...i.original.media.map((m) => m.src), ...(i.original.author.avatar ? [i.original.author.avatar] : [])];
  return i.media.filter((m) => !m.video || m.video.endsWith('.m3u8')).map((m) => m.src);
}));
const counts: Record<string, number> = {};
for (const i of stream) counts[i.kind] = (counts[i.kind] ?? 0) + 1;
const issue = stream.filter((i) => i.kind !== 'note' && i.kind !== 'reshare').length;
const printed = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base description={`nate.rip, issue ${issue}: work, writing and clippings from Nate Butler.`} bodyClass="issue">
  <main class="zine">
    {spreads.map((s) => {
      switch (s.kind) {
        case 'cover': return <Cover spread={s} issue={issue} counts={counts} printed={printed} />;
        case 'contents': return <Contents spread={s} spreads={spreads} issue={issue} />;
        case 'post': return <PostSpread spread={s} />;
        case 'shot': return <ShotSpread spread={s} />;
        case 'list': return <ListSpread spread={s} />;
        case 'bulletin': return <BulletinSpread spread={s} />;
        case 'clippings': return <ClippingsSpread spread={s} />;
        case 'section': return <SectionSpread spread={s} />;
        case 'jump': return <JumpSpread spread={s} />;
      }
    })}
    <footer class="colophon-end">
      <p>End of issue {issue}. Back to the <a href="#p-0">cover</a>.</p>
    </footer>
  </main>
  <script>
    import { pressRun } from '../scripts/press';
    pressRun();
  </script>
</Base>
