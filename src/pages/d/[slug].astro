---
/**
 * A local draft on its own page: the whole text, its figures and facts,
 * stamped as a proof. Not indexed; drafts aren't published yet.
 */
import Base from '../../layouts/Base.astro';
import Reg from '../../components/riso/Reg.astro';
import Plate from '../../components/riso/Plate.astro';
import InkFig from '../../components/riso/drafts/InkFig.astro';
import ProofStamp from '../../components/riso/drafts/ProofStamp.astro';
import { loadDrafts, type Draft } from '../../lib/drafts';
import { renderMarkdownWithHeadings } from '../../lib/markdown';
import { draftDesign, printDate, readingMinutes, hash, rng } from '../../lib/zine';
import { media } from '../../components/riso/drafts/util';

export function getStaticPaths() {
  return loadDrafts().map((d) => ({ params: { slug: d.slug }, props: { draft: d } }));
}

const { draft: d } = Astro.props as { draft: Draft };
const { html, headings } = await renderMarkdownWithHeadings(d.text);
const [lt, dk] = draftDesign(d.slug).inks[0];
const r = rng(hash(d.key));
const mins = readingMinutes(d.text);
// Tones of the screenshots, judged by eye (see the designs).
const TONES: Record<string, number> = {
  'icon-stable.png': 0.2, 'icon-canary.png': 0.24,
  'showcase-home.png': 0.2, 'showcase-control-sizes.png': 0.18,
  'homepage.png': 0.9, 'homepage-notes.png': 0.9,
};
// Hang the pictures between sections, in order.
const parts = html.split(/(?=<h2[\s>])/);
const figs = d.images;
const per = Math.max(1, Math.ceil(figs.length / Math.max(1, parts.length - 1)));
const sections = parts.map((h, i) => ({ html: h, figs: i === 0 ? [] : figs.slice((i - 1) * per, i * per) }));
const leftover = figs.slice((parts.length - 1) * per);
---
<Base title={`${d.title} (proof)`} description={d.dek} bodyClass="single" noindex>
  <main
    class="single-page single-post single-draft"
    style={`--lt:var(--${lt});--dk:var(--${dk});--mx:${r.range(-2.4, 2.4).toFixed(2)}px;--my:${r.range(-1.8, 1.8).toFixed(2)}px;--lx:0px;--ly:0px`}
  >
    <nav class="single-nav" aria-label="Issue">
      <a href="/">_fragments, current issue</a>
      <span>Proof, not yet published</span>
    </nav>
    <article class="sheet single-sheet paper-newsprint" data-kind="draft">
      <div class="single-paper">
        <ProofStamp date={d.date} class="ps-single" />
        <header class="single-head">
          <p class="single-kind">{d.kicker}, in proof</p>
          <Reg as="h1" text={d.title} class="t-tower single-title" style={`--fs:clamp(44px, ${Math.min(13, Math.max(6, 110 / Math.pow(d.title.length, 0.7))).toFixed(2)}vw, 150px)`} />
          <p class="draft-dek">{d.dek}</p>
          <p class="cap single-meta">
            <time datetime={d.date}>{printDate(d.date)}</time>
            <span>{mins} minute read</span>
            {d.repo && <a href={d.repo} target="_blank" rel="noopener">Source</a>}
          </p>
        </header>
        <div class:list={['single-body', headings.length > 1 && 'has-toc']}>
          {headings.length > 1 && (
            <nav class="margin-toc" aria-label="In this piece">
              <p class="cap">In this piece</p>
              <ol>{headings.map((h) => <li class={`toc-${h.level}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
            </nav>
          )}
          <div class="prose-article dropcap-article">
            {sections.map((s) => (
              <Fragment>
                <Fragment set:html={s.html} />
                {s.figs.map((im) => im.figure ? (
                  <InkFig image={im} ink="dk" ghost="lt" class="draft-fig" />
                ) : (
                  <figure class="draft-shot single-plate">
                    <Plate media={media(im, TONES[im.src.split('/').pop()!] ?? 0.6)!} inks={[lt, dk]} fit="contain" proof />
                    <figcaption class="cap">{im.caption} <button class="proof-toggle" type="button" aria-pressed="false">Show original color</button></figcaption>
                  </figure>
                ))}
              </Fragment>
            ))}
            {leftover.map((im) => im.figure
              ? <InkFig image={im} ink="dk" ghost="lt" class="draft-fig" />
              : <figure class="draft-shot single-plate"><Plate media={media(im, TONES[im.src.split('/').pop()!] ?? 0.6)!} inks={[lt, dk]} fit="contain" proof /><figcaption class="cap">{im.caption} <button class="proof-toggle" type="button" aria-pressed="false">Show original color</button></figcaption></figure>)}
          </div>
        </div>
        <footer class="draft-foot">
          {d.facts.length > 0 && (
            <dl class="draft-facts">{d.facts.map((f) => <Fragment><dt>{f.label}</dt><dd>{f.value}</dd></Fragment>)}</dl>
          )}
          {d.links.length > 0 && (
            <ul class="draft-links">{d.links.map((l) => <li><a href={l.url} target="_blank" rel="noopener">{l.label}</a></li>)}</ul>
          )}
        </footer>
      </div>
    </article>
  </main>
  <script>
    import { pressSingle } from '../../scripts/single';
    pressSingle();
  </script>
</Base>
