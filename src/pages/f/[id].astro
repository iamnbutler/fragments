---
import Base from '../../layouts/Base.astro';
import Reg from '../../components/riso/Reg.astro';
import Plate from '../../components/riso/Plate.astro';
import { fetchAllFragments } from '../../lib/atproto';
import { fragmentItem } from '../../lib/stream';
import { measureAll } from '../../lib/tone';
import { renderMarkdownWithHeadings } from '../../lib/markdown';
import { domain, hash, inline, listEntries, paragraphs, printDate, readingMinutes, rng, type Ink } from '../../lib/zine';
import type { Fragment } from '../../lib/types';

export async function getStaticPaths() {
  const fragments = await fetchAllFragments();
  return fragments.map((f) => ({
    params: { id: String(f.id) },
    props: { fragment: f, allFragments: fragments },
  }));
}

const { fragment, allFragments } = Astro.props as { fragment: Fragment; allFragments: Fragment[] };
const item = fragmentItem(fragment);
await measureAll(item.media.filter((m) => !m.video).map((m) => m.src));
const { html, headings } = fragment.content
  ? await renderMarkdownWithHeadings(fragment.content)
  : { html: '', headings: [] };

const sorted = [...allFragments].sort((a, b) => a.id - b.id);
const idx = sorted.findIndex((f) => f.id === fragment.id);
const prev = idx > 0 ? sorted[idx - 1] : null;
const next = idx < sorted.length - 1 ? sorted[idx + 1] : null;

const PAIRS: [Ink, Ink][] = [['pink', 'black'], ['orange', 'black'], ['pink', 'blue'], ['orange', 'blue']];
const seed = hash(`f-${fragment.id}`);
const r = rng(seed);
const inks = PAIRS[seed % PAIRS.length];
const mx = r.range(-2.4, 2.4).toFixed(2);
const my = r.range(-1.8, 1.8).toFixed(2);
const date = printDate(fragment.createdAt);
const mins = readingMinutes(fragment.content ?? '');
const len = fragment.title.length;
const titleSize = Math.min(15, Math.max(6, 120 / Math.pow(len, 0.7)));
const KIND = { post: 'Essay', shot: 'Plate', list: 'Index', link: 'Recommended reading' } as const;
const entries = fragment.type === 'list' ? listEntries(fragment.content ?? '') : [];
const sections = [...new Set(entries.map((e) => e.section ?? ''))];
const intro = fragment.type === 'list' ? paragraphs(fragment.content ?? '', fragment.title)[0] : '';
const hasLinkItems = entries.some((e) => e.href);
const issue = allFragments.length;
const desc = inline(paragraphs(fragment.content ?? '', fragment.title)[0] ?? '').slice(0, 160);
---
<Base title={fragment.title} atUri={fragment.atUri} description={desc || undefined} bodyClass="single">
  <main
    class:list={['single-page', `single-${fragment.type}`]}
    style={`--lt:var(--${inks[0]});--dk:var(--${inks[1]});--mx:${mx}px;--my:${my}px;--lx:${r.range(-26, 26).toFixed(1)}px;--ly:${r.range(-18, 18).toFixed(1)}px`}
  >
    <nav class="single-nav" aria-label="Issue">
      <a href="/">nate.rip, issue {issue}</a>
      <span>No. {fragment.id}</span>
    </nav>

    <article class="sheet single-sheet paper-newsprint" data-kind={fragment.type}>
      <div class="single-paper">
        <header class="single-head">
          <p class="single-kind">{KIND[fragment.type]} no. {fragment.id}</p>
          <Reg as="h1" text={fragment.title} class="t-tower single-title" style={`--fs:clamp(44px, ${titleSize.toFixed(2)}vw, ${(titleSize * 12).toFixed(0)}px)`} />
          <p class="cap single-meta">
            <time datetime={fragment.createdAt}>{date}</time>
            {fragment.type === 'post' && <span>{mins} minute read</span>}
            {fragment.type === 'shot' && <span>{item.media.length} frame{item.media.length === 1 ? '' : 's'}</span>}
            {fragment.type === 'list' && <span>{entries.length} entries</span>}
            {fragment.type === 'link' && item.url && <span>{domain(item.url)}</span>}
          </p>
        </header>

        {fragment.type === 'shot' && (
          <div class="single-plates">
            {item.media.map((m, i) => (
              <div class="single-plate">
                <Plate media={m} inks={i % 2 ? [inks[0] === 'pink' ? 'orange' : 'pink', inks[1]] : inks} fit="contain" alt={m.alt || `${fragment.title}${item.media.length > 1 ? `, frame ${i + 1}` : ''}`} proof={!m.video} eager={i === 0} />
                <div class="single-plate-foot">
                  <span class="cap">Frame {i + 1} of {item.media.length}</span>
                  {!m.video && <button class="proof-toggle" type="button" aria-pressed="false">Show original color</button>}
                </div>
              </div>
            ))}
          </div>
        )}

        {fragment.type === 'link' && item.url && (
          <div class="single-coupon">
            <article class="notice coupon" style="--tilt:-1.2deg">
              <svg class="scissors" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm0 12a3 3 0 1 1 0-6 3 3 0 0 1 0 6zM8.1 7.6 20 18M8.1 16.4 20 6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
              <div class="coupon-in">
                <p class="coupon-no">Recommended reading, no. {fragment.id}</p>
                <p class="coupon-title"><a href={item.url} target="_blank" rel="noopener">Read “{fragment.title}”</a></p>
                <p class="coupon-foot"><span class="coupon-domain">{domain(item.url)}</span></p>
              </div>
            </article>
          </div>
        )}

        {fragment.type === 'list' && hasLinkItems ? (
          <div class="single-index">
            {intro && <p class="index-intro">{intro}</p>}
            {(
              sections.map((s) => (
                <section class="ix-section">
                  {s && <h2 class="ix-section-title" id={s.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>{s}</h2>}
                  <ol class="index-list">
                    {entries.filter((e) => (e.section ?? '') === s).map((e) => (
                      <li>
                        <span class="ix-no">{String(entries.indexOf(e) + 1).padStart(2, '0')}</span>
                        <span class="ix-body">
                          {e.href ? <a class="ix-label" href={e.href} target="_blank" rel="noopener">{e.label}</a> : <span class="ix-label">{e.label}</span>}
                          {e.note && <span class="ix-note">{e.note}</span>}
                        </span>
                        <span class="ix-where">{e.href ? domain(e.href) : ''}</span>
                      </li>
                    ))}
                  </ol>
                </section>
              ))
            )}
          </div>
        ) : (
          html && (
            <div class:list={['single-body', headings.length > 1 && 'has-toc']}>
              {headings.length > 1 && (
                <nav class="margin-toc" aria-label="In this piece">
                  <p class="cap">In this piece</p>
                  <ol>
                    {headings.map((h) => (
                      <li class={`toc-${h.level}`}><a href={`#${h.slug}`}>{h.text}</a></li>
                    ))}
                  </ol>
                </nav>
              )}
              <div class:list={['prose-article', fragment.type === 'post' && 'dropcap-article']} set:html={html} />
            </div>
          )
        )}
      </div>
    </article>

    <nav class="turn" aria-label="Turn the page">
      {prev ? (
        <a class="turn-prev" href={`/f/${prev.id}`}><span class="cap">Previous page, {prev.id}</span><span class="turn-title">{prev.title}</span></a>
      ) : <span />}
      {next ? (
        <a class="turn-next" href={`/f/${next.id}`}><span class="cap">Next page, {next.id}</span><span class="turn-title">{next.title}</span></a>
      ) : <span />}
    </nav>
  </main>
  <script>
    import { pressSingle } from '../../scripts/single';
    pressSingle();
  </script>
</Base>
